# DocuLens AI -- Environment Configuration
# Copy to .env and adjust values. Never commit .env.

DOCULENS_DEVICE=cpu
DOCULENS_EMBED_MODEL=BAAI/bge-small-en-v1.5
DOCULENS_LLM_MODEL=microsoft/phi-2
DOCULENS_SUMM_MODEL=facebook/bart-large-cnn
DOCULENS_VECTOR_STORE=chromadb
DOCULENS_CHROMA_PERSIST_DIR=./data/chroma
DOCULENS_DEFAULT_CHUNK_SIZE=512
DOCULENS_DEFAULT_CHUNK_OVERLAP=50
DOCULENS_HOST=0.0.0.0
DOCULENS_PORT=8000
DOCULENS_MAX_UPLOAD_SIZE_MB=50
# DOCULENS_OCR_BACKEND=paddleocr
# DOCULENS_OPENAI_API_KEY=sk-...
# DOCULENS_HF_API_TOKEN=hf_...
